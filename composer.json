{
    "name": "app/vending-machine",
    "description": "PHP vending machine with session auth, attribute routing, and a JWT API.",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "firebase/php-jwt": "^6.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Core/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:controller": "phpunit --testsuite Controller",
        "test:integration": "phpunit --testsuite Integration",
        "test:regression": "phpunit",
        "serve": "php -S localhost:8080 -t public public/router.php",
        "install-db": "php bin/install.php"
    }
}
